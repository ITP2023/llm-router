# Copy to .env and fill in real values. .env is gitignored.
LLM_ROUTER_DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_ROUTER_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_ROUTER_MODELS=deepseek-chat,deepseek-reasoner
LLM_ROUTER_LISTEN=127.0.0.1:18080
# Set to mockllm for a credential-free local upstream (in-process test LLM).
LLM_ROUTER_PROVIDER=deepseek
